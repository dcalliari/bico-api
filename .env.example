# --- Segurança ---
# Chave secreta para assinatura dos tokens JWT
JWT_SECRET=sua-chave-secreta-aqui

# --- Banco de Dados ---
# URL completa do JDBC: jdbc:postgresql://<host>:<port>/<database>
DB_URL=jdbc:postgresql://localhost:5432/bicos
DB_USER=seu_usuario
DB_PASSWORD=sua_senha

# Variáveis auxiliares (úteis para scripts ou docker-compose)
CHAVE_DB=bicos
CHAVE_PORT=5432

# CORS Config
ALLOWED_ORIGINS=http://meuapp.com